# Copy this to .env and fill in real values.
# .env is gitignored.

# ===== Compose environment =====
# Controls which overlay files are merged. Adjust per worktree:
#   prod:    COMPOSE_FILE=docker-compose.yml:overlays/prod.yml
#   staging: COMPOSE_FILE=docker-compose.yml:overlays/staging.yml
#   dev:     COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml:overlays/prod.yml

# ===== ACME / Let's Encrypt =====
# Email Let's Encrypt uses for cert expiry warnings + ToS agreement.
# Set up via Cloudflare Email Routing → forwards to your real inbox.
ACME_EMAIL=acme@bluefox.cafe

# ===== Auth signing key =====
# Generate with: openssl rand -hex 32
# Signs/verifies the JWT session cookies issued by the auth portal.
# If you regenerate this, all sessions invalidate (everyone re-auths via Discord).
JWT_SHARED_KEY=

# ===== Discord OAuth =====
# From https://discord.com/developers/applications → your app → OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Per-guild IDs. Discord ▸ Settings ▸ Advanced ▸ Developer Mode,
# then right-click guild name ▸ Copy Server ID.
# Each guild maps to one authorization policy in caddy/Caddyfile;
# a single guild can gate multiple games (e.g. demiplane gates both
# beastworld and starwars today).
DISCORD_GUILD_DEMIPLANE=
# Optional - only set when adding a second guild. Leave blank otherwise;
# the matching transform/filter/policy in caddy/Caddyfile are commented
# out and must be activated together.
DISCORD_GUILD_EXAMPLE_2=

# Your Discord user ID (NOT a guild ID). Same Developer Mode trick: right-click
# your name → Copy User ID. This account has admin access to all services
# (kuma, logs, test) regardless of guild membership.
DISCORD_ADMIN_USER_ID=

# ===== Per-game Foundry credentials =====
# Each DM provides their foundryvtt.com username + password (used to download
# the Foundry release zip on first container boot) and license key.
FOUNDRY_USERNAME_BISCUIT=
FOUNDRY_PASSWORD_BISCUIT=
FOUNDRY_LICENSE_BISCUIT=

FOUNDRY_USERNAME_RISUNA=
FOUNDRY_PASSWORD_RISUNA=
FOUNDRY_LICENSE_RISUNA=

# ===== Watchtower notifications (optional) =====
# Discord webhook URL converted to shoutrrr format.
# Webhook URL: https://discord.com/api/webhooks/<ID>/<TOKEN>
# Shoutrrr URL: discord://<TOKEN>@<ID>
WATCHTOWER_DISCORD_WEBHOOK=