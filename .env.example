# Copy this to .env and fill in real values.
# .env is gitignored.

# ===== Compose environment =====
# Controls which overlay files are merged. Adjust per worktree:
#   prod:    COMPOSE_FILE=docker-compose.yml:overlays/prod.yml
#   staging: COMPOSE_FILE=docker-compose.yml:overlays/staging.yml
#   dev:     COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml:overlays/prod.yml

# ===== ACME / Let's Encrypt =====
# Email Let's Encrypt uses for cert expiry warnings + ToS agreement.
# Set up via Cloudflare Email Routing → forwards to your real inbox.
ACME_EMAIL=acme@bluefox.cafe

# Cloudflare API token used for ACME DNS-01 challenges.
#
# Background - how Let's Encrypt proves you own a domain:
#   HTTP-01: LE tells Caddy "serve this random token at
#            http://<domain>/.well-known/acme-challenge/<token>", then
#            fetches it over port 80. Proves you control the webserver
#            answering for that exact hostname. Cannot issue wildcards
#            (*.bluefox.cafe) because there is no single hostname for LE
#            to hit. Also breaks if port 80 is firewalled or in use.
#
#   DNS-01:  LE tells Caddy "publish this random token as a TXT record
#            at _acme-challenge.<domain>", then queries DNS for it.
#            Proves you control the zone, which is strictly stronger
#            than controlling one host in the zone - so LE will issue a
#            wildcard. Needs API credentials for the DNS provider.
#
# We use DNS-01 globally because:
#   1. Required for the *.bluefox.cafe wildcard cert that backs the
#      catchall site (returns a clean 404 instead of a TLS warning on
#      unknown subdomains).
#   2. Renewals no longer depend on port 80 reaching this host - works
#      even if the cloud firewall, an ISP, or a future setup change
#      blocks :80.
#   3. Certs can be issued for hostnames that aren't yet publicly
#      resolvable or routable (useful for staging a new site before
#      DNS points at it).
#
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token
#   Permissions:    Zone — DNS — Edit
#   Zone Resources: Include — Specific zone — bluefox.cafe
CLOUDFLARE_API_TOKEN=

# ===== Auth signing key =====
# Generate with: openssl rand -hex 32
# Signs/verifies the JWT session cookies issued by the auth portal.
# If you regenerate this, all sessions invalidate (everyone re-auths via Discord).
JWT_SHARED_KEY=

# ===== Discord OAuth =====
# From https://discord.com/developers/applications → your app → OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Per-guild IDs. Discord ▸ Settings ▸ Advanced ▸ Developer Mode,
# then right-click guild name ▸ Copy Server ID.
# Each guild maps to one authorization policy in caddy/Caddyfile;
# a single guild can gate multiple games (e.g. demiplane gates both
# demiplane and beastworld today).
DISCORD_GUILD_DEMIPLANE=
# Optional - only set when adding a second guild. Leave blank otherwise;
# the matching transform/filter/policy in caddy/Caddyfile are commented
# out and must be activated together.
DISCORD_GUILD_EXAMPLE_2=

# Your Discord user ID (NOT a guild ID). Same Developer Mode trick: right-click
# your name → Copy User ID. This account has admin access to all services
# (kuma, logs, test) regardless of guild membership.
DISCORD_ADMIN_USER_ID=

# ===== Per-game Foundry credentials =====
# Each DM provides their foundryvtt.com username + password (used to download
# the Foundry release zip on first container boot) and license key.
#
# FOUNDRY_ADMIN_KEY_* gates the /setup configuration page (world/module/server
# management). Distinct from the in-world Gamemaster password. The stack is
# already Discord-gated at Caddy, so this is defence in depth: the last line
# before someone can wipe worlds or install arbitrary modules if forward-auth
# is ever misconfigured or bypassed. Generate with: openssl rand -hex 24
FOUNDRY_USERNAME_BISCUIT=
FOUNDRY_PASSWORD_BISCUIT=
FOUNDRY_LICENSE_BISCUIT=
FOUNDRY_ADMIN_KEY_BISCUIT=

FOUNDRY_USERNAME_ZANDER=
FOUNDRY_PASSWORD_ZANDER=
FOUNDRY_LICENSE_ZANDER=
FOUNDRY_ADMIN_KEY_ZANDER=

FOUNDRY_USERNAME_RISUNA=
FOUNDRY_PASSWORD_RISUNA=
FOUNDRY_LICENSE_RISUNA=
FOUNDRY_ADMIN_KEY_RISUNA=
