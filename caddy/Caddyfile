    reverse_proxy dozzle:8080
}

# ─────────────────────────────────────────────────────────────────────
# Filebrowser - Discord-gated at the edge (any guild member), then
# filebrowser's own user list is the authoritative ACL. Per-user scope
# (which game's modules they can see) is set inside filebrowser.
# ─────────────────────────────────────────────────────────────────────
files.bluefox.cafe {
    import access_log
    import gated_proxy_site files dnd_policy filebrowser:80
}

# ─────────────────────────────────────────────────────────────────────
# Catchall - any *.bluefox.cafe subdomain not matched above.
# Without this, unknown subdomains hit Caddy's default fallback with no
# valid cert for that hostname, so browsers show a cert mismatch warning
# before the user ever sees a response. The wildcard cert (issued via
# Cloudflare DNS-01) covers anything under bluefox.cafe so we can return
# a clean themed 404 instead.
# ─────────────────────────────────────────────────────────────────────
*.bluefox.cafe {
    import access_log
    import security_headers
    import error_pages
    import public_assets
    error 404
}
