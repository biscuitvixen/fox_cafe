{
    # Global options block

    email {$ACME_EMAIL}

    # Use Cloudflare DNS-01 for every ACME challenge. Required for the
    # *.bluefox.cafe wildcard cert (HTTP-01 can't do wildcards), and
    # nicely removes the port-80 dependency for renewals on every other
    # site too. Token needs Zone:DNS:Edit scoped to bluefox.cafe.
    acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}

    # Disable the admin API on its default port. We don't manage Caddy via API,
    # and leaving this open inside the container is mild attack surface.
    admin off

    # ─────────────────────────────────────────────────────────────────
    # caddy-security: identity provider, auth portal, authorization policies
    # ─────────────────────────────────────────────────────────────────
    security {
        # Discord as the OAuth identity provider.
        # `user_group_filters` accepts multiple guild IDs (space-separated).
        # For each guild the user is in, authcrunch attaches a synthetic role
        # `discord.com/<guild_id>/members` to their session token. We then
        # map those guild roles to local roles in the transforms below.
        oauth identity provider discord {
            realm discord
            driver discord
            client_id     {$DISCORD_CLIENT_ID}
            client_secret {$DISCORD_CLIENT_SECRET}
            scopes identify guilds
            # Add additional guild IDs here as new Discord servers come online.
            user_group_filters {$DISCORD_GUILD_DEMIPLANE}
            # user_group_filters {$DISCORD_GUILD_DEMIPLANE} {$DISCORD_GUILD_EXAMPLE_2}
        }

        # The auth portal - owns the OAuth flow + JWT issuance. Its built-in
        # home page UI is intentionally not linked from anywhere; we serve our
        # own landing page instead (see dnd.bluefox.cafe below).
        authentication portal foundryauth {
            crypto default token lifetime 604800
            crypto key sign-verify {$JWT_SHARED_KEY}

            enable identity provider discord

            # CRITICAL: cookie domain must be the apex, NOT a subdomain.
            # This is what makes one login cover all *.bluefox.cafe sites.
            cookie domain bluefox.cafe
            cookie lifetime 604800
            # CSRF defence: browser refuses to attach this cookie to
            # cross-site POSTs / fetches / iframes. `lax` (not `strict`)
            # because the OAuth callback redirect from discord.com needs
            # the cookie on a top-level navigation - `strict` would break
            # the login flow.
            #
            # NOTE: as of authcrunch v1.0.41, the SessionID cookie builder
            # in go-authcrunch doesn't read this directive - only the
            # access-token cookie path does. We're still protected because
            # all current browsers default unmarked cookies to Lax. Keep
            # the directive: it documents intent and will start applying
            # to AUTHP_SESSION_ID if upstream fixes the omission.
            cookie samesite lax

            # Honour the redirect_url query param (which the policy auto-appends
            # when bouncing unauthenticated users here). Without this directive
            # authcrunch treats every off-portal redirect as untrusted and
            # silently drops the user on the portal home after OAuth instead of
            # sending them back where they came from.
            trust login redirect uri domain suffix bluefox.cafe path prefix /

            # Demiplane guild → guild-specific role + generic member role.
            # One Discord server currently gates every game; if a game ever
            # needs its own guild, copy the example block below.
            transform user {
                match role discord.com/{$DISCORD_GUILD_DEMIPLANE}/members
                action add role authp/guild_demiplane
            }
            transform user {
                match role discord.com/{$DISCORD_GUILD_DEMIPLANE}/members
                action add role authp/member
            }

            # Template for a future second guild. Uncomment, swap the env var
            # and role names, and add a matching authorization policy below.
            # transform user {
            #     match role discord.com/{$DISCORD_GUILD_EXAMPLE_2}/members
            #     action add role authp/guild_example_2
            # }
            # transform user {
            #     match role discord.com/{$DISCORD_GUILD_EXAMPLE_2}/members
            #     action add role authp/member
            # }

            # Admin (me). authcrunch exposes the Discord user as
            # sub=discord.com/<user_id>.
            transform user {
                match sub discord.com/{$DISCORD_ADMIN_USER_ID}
                action add role authp/admin
            }

            # Compatibility role: authcrunch's own portal ACL wants
            # authp/user on logged-in users. We don't expose the portal home,
            # but keep this so /auth/* never surprises us. NO service
            # authorizes on authp/user - only on guild_*, member, or admin.
            transform user {
                match realm discord
                action add role authp/user
            }
        }

        # ─────────────────────────────────────────────────────────────
        # Authorization policies (one per access tier)
        # ─────────────────────────────────────────────────────────────

        # DnD landing page - any guild member or admin.
        authorization policy dnd_policy {
            set auth url https://auth.bluefox.cafe/auth/
            set forbidden url https://bluefox.cafe/forbidden
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "any guild member"
                match role authp/member
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Demiplane games - demiplane guild + admin.
        # Currently gates both demiplane and beastworld; split into per-game
        # policies if/when those games need separate guilds.
        authorization policy demiplane_policy {
            set auth url https://auth.bluefox.cafe/auth/
            set forbidden url https://bluefox.cafe/forbidden
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "demiplane guild"
                match role authp/guild_demiplane
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Template policy for a future second guild - admin + that guild.
        # Safe to leave active: the matching transform that produces
        # authp/guild_example_2 is commented out above, so this currently
        # denies everyone except admin. Activate by (1) setting
        # DISCORD_GUILD_EXAMPLE_2 in .env, (2) uncommenting the transform
        # block above, (3) uncommenting the user_group_filters entry, and
        # (4) importing gated_example_2 on the relevant site block.
        authorization policy example_2_policy {
            set auth url https://auth.bluefox.cafe/auth/
            set forbidden url https://bluefox.cafe/forbidden
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "example_2 guild"
                match role authp/guild_example_2
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Admin-only - uptime, logs, anything ops.
        authorization policy admin_policy {
            set auth url https://auth.bluefox.cafe/auth/
            set forbidden url https://bluefox.cafe/forbidden
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin only"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }
    }
}

# ─────────────────────────────────────────────────────────────────────
# Reusable snippets - keep per-site config DRY
# ─────────────────────────────────────────────────────────────────────

# Public passthroughs for the apex-level shared trees that every themed
# page references with root-relative URLs (/css/<bundle>.css, /fonts/*,
# /shared/og/*). Imported by each gated site so these requests resolve
# from the apex build without ever touching the per-site root - which
# keeps gated subdomains physically unable to read each other's content
# (see access-control note on gated_static_site).
#
# handle_path strips the matched prefix before applying root, and runs
# before the gated handle{} block, so these assets bypass authorize.
# That's intentional: CSS, fonts, and OG images are public by design.
(public_assets) {
    handle_path /shared/* {
        root * /srv/bluefox.cafe/current/shared
        file_server
    }
    handle_path /css/* {
        root * /srv/bluefox.cafe/current/css
        file_server
    }
    handle_path /fonts/* {
        root * /srv/bluefox.cafe/current/fonts
        file_server
    }
}

# Strict CSP for the static landing pages (homepage, dnd). Blocks any
# resource not loaded from one of the explicit origins below - even if an
# attacker manages to inject HTML, they can't pull a payload from a
# random domain.
#
# `'unsafe-inline'` on script-src/style-src is required because the pages
# use inline <script> blocks for Vue templating and Tailwind's runtime
# injects inline styles. Removing this would mean refactoring to nonces
# or external files; out of scope for now. CSP still meaningfully
# restricts the loadable origins despite the inline allowance.
#
# Do NOT import this on Foundry sites - Foundry's client uses inline
# scripts, dynamic imports, and module-specific resources we don't
# enumerate, so a strict CSP would break gameplay. The global
# `frame-ancestors 'none'` from (security_headers) still applies there.

(static_csp) {
    header Content-Security-Policy "default-src 'self'; \
        script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com; \
        style-src  'self' 'unsafe-inline' https://cdnjs.cloudflare.com; \
        font-src   'self' https://cdnjs.cloudflare.com data:; \
        img-src    'self' data: https:; \
        connect-src 'self'; \
        frame-ancestors 'none'; \
        base-uri 'self'; \
        form-action 'self'"
}

(security_headers) {
    header {
        # HSTS: tell browsers to ALWAYS use HTTPS for this domain for 1 year.
        # `preload` requests inclusion in the browser-shipped HSTS list.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Block content-type sniffing - defence against MIME confusion attacks.
        X-Content-Type-Options "nosniff"
        # Send origin only (no path) on cross-origin requests.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Clickjacking defence: refuse to be embedded in any iframe.
        # `frame-ancestors 'none'` is the modern CSP equivalent; the older
        # `X-Frame-Options: DENY` is kept for legacy browser compat. This
        # only blocks OTHER pages from framing us - our own pages can still
        # use iframes internally (e.g. Foundry's UI). If a future feature
        # ever needs same-origin embedding, swap to `frame-ancestors 'self'`
        # and `X-Frame-Options: SAMEORIGIN`.
        Content-Security-Policy "frame-ancestors 'none'"
        X-Frame-Options "DENY"
        # Don't advertise that we're Caddy.
        -Server
    }
}

# JSON access log written to a shared volume that crowdsec mounts read-only
# and parses for HTTP-layer scenarios (scanning, bruteforce, CVE probes).
# Imported by every site - without the import a site's requests are invisible
# to crowdsec. Roll at 100MB / keep 5 to bound disk use; crowdsec tails by
# inode so rotations don't lose events.
(access_log) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
        level INFO
    }
}

# Currently unused - superseded by (gated_static_site) / (gated_proxy_site)
# below, which fold these in alongside the bot-preview bypass. Kept
# commented as a reference for the simplest possible "auth + headers"
# bundle, in case a future site needs gating without a public preview.
# (gated_dnd) {
#     import security_headers
#     authorize with dnd_policy
# }
#
# (gated_demiplane) {
#     import security_headers
#     authorize with demiplane_policy
# }
#
# (gated_example_2) {
#     import security_headers
#     authorize with example_2_policy
# }

(gated_admin) {
    import security_headers
    authorize with admin_policy
}

# Link-preview bypass for gated sites. When a known crawler bot (the
# things that build link-preview cards in Discord, Telegram, Slack, etc.)
# fetches a gated URL, serve a small public HTML page with OG/Twitter
# meta tags instead of bouncing it to the OAuth wall. Without this,
# every shared link in chat shows the auth page as its preview.
#
# Used as: `import preview_bot <name>` where the Hugo build emits
# previews/<name>/index.html under /srv/bluefox.cafe/current/. Must be
# imported BEFORE the catchall `handle { authorize ... }` so its
# `handle @preview_bot` matches first.
#
# Rooted at the preview subdir and rewriting every bot request to
# index.html, so the bot gets exactly one page no matter what path it
# probes. The page's root-relative /css/*, /fonts/*, /shared/* refs are
# served by (public_assets), which the gated site imports separately
# and which matches before this snippet's handle{} block.
#
# IMPORTANT: User-Agent is trivially spoofable, so the previews/<name>/
# tree must contain ONLY content safe to expose publicly (title, blurb,
# cover image). Never put real game data, file listings, or anything
# member-only in there.
(preview_bot) {
    @preview_bot header_regexp User-Agent (?i)(Telegrambot|Discordbot|Twitterbot|Slackbot|facebookexternalhit|LinkedInBot|WhatsApp|SkypeUriPreview|Embedly|redditbot|Applebot|Mastodon|Pleroma|Iframely|Bluesky|vkShare|Synapse)
    handle @preview_bot {
        root * /srv/bluefox.cafe/current/previews/{args[0]}
        rewrite * /index.html
        file_server
        header Cache-Control "public, max-age=300"
    }
}

# Full bundle for a gated static-file site. Wraps: security headers,
# strict CSP, themed error pages, bot-preview bypass, and the auth gate
# itself. Each call collapses to one `import` line in the site block.
#
#   args[0] = name (the Hugo build emits content at /<name>/ and a bot
#             preview at /previews/<name>/ under /srv/bluefox.cafe/current/)
#   args[1] = authorization policy name (e.g. dnd_policy)
#
# Rooted at the site's own /<name>/ subdir so the gated handler is
# physically incapable of reading another gated subdomain's tree even
# if the request URI tries to escape (e.g. /demiplane/index.html from
# dnd.bluefox.cafe just 404s). Shared assets that the page references
# with root-relative URLs (/css/*, /fonts/*, /shared/*) come from
# (public_assets), whose handle_path entries match before this handle{}.
(gated_static_site) {
    import security_headers
    import static_csp
    import error_pages
    import preview_bot {args[0]}
    import public_assets

    handle {
        authorize with {args[1]}
        root * /srv/bluefox.cafe/current/{args[0]}
        file_server
    }

    encode zstd gzip
}

# Full bundle for a gated reverse-proxy site (Foundry, filebrowser, etc).
# Same as gated_static_site but proxies to an upstream and skips static_csp
# - Foundry's client and filebrowser both rely on inline scripts and
# dynamic resources that a strict CSP would break.
#
#   args[0] = preview directory name (Hugo build emits previews/<name>/
#             under /srv/bluefox.cafe/current/)
#   args[1] = authorization policy name
#   args[2] = upstream host:port (e.g. foundry-beastworld:30000)
(gated_proxy_site) {
    import security_headers
    import error_pages
    import preview_bot {args[0]}
    import public_assets

    handle {
        authorize with {args[1]}
        reverse_proxy {args[2]}
    }

    encode zstd gzip
}

# Themed error pages served from the Hugo build under
# /srv/bluefox.cafe/current/errors/<code>/ (pretty URLs - the rewrite
# targets the directory and file_server resolves its index.html).
# Note: caddy-security returns 401 (not 403) when an authenticated user
# lacks the required role - a quirk of the upstream module - so we map
# both to the 403 page. Root is set inside each handle_errors block so
# this works for both static and reverse_proxy site blocks (the latter
# don't set a site-level root).
(error_pages) {
    handle_errors 401 403 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/403/
        file_server
    }
    handle_errors 404 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/404/
        file_server
    }
    handle_errors 500 502 503 504 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/5xx/
        file_server
    }
}

# ─────────────────────────────────────────────────────────────────────
# Apex - public homepage
# ─────────────────────────────────────────────────────────────────────
bluefox.cafe {
    import access_log
    import security_headers
    import static_csp
    import error_pages
    import public_assets

    # Release-symlink layout: deploy.sh writes /srv/bluefox.cafe/releases/<ts>/
    # and flips current via `ln -sfn`. Caddy follows the symlink on the next
    # request, so publishes are zero-downtime with no reload.
    root * /srv/bluefox.cafe/current

    # Authcrunch redirects here on authorization failure (`set forbidden url`
    # in each policy). We raise a real 403 so handle_errors serves the themed
    # page with the correct status code.
    handle /forbidden {
        error 403
    }

    # Admin-only preview routes for the themed error pages. Useful for
    # iterating on the design without having to log out / break ACLs to
    # trigger a real denial. Non-admins are bounced to /forbidden.
    handle /previews/403 {
        authorize with admin_policy
        error 403
    }
    handle /previews/404 {
        authorize with admin_policy
        error 404
    }
    handle /previews/500 {
        authorize with admin_policy
        error 500
    }
    handle /previews/502 {
        authorize with admin_policy
        error 502
    }
    handle /previews/503 {
        authorize with admin_policy
        error 503
    }

    handle {
        file_server
    }

    encode zstd gzip
}

# ─────────────────────────────────────────────────────────────────────
# Auth portal - public, this is where the Discord redirect lands
# ─────────────────────────────────────────────────────────────────────
auth.bluefox.cafe {
    import access_log
    import security_headers
    import error_pages
    import public_assets
    route /auth* {
        authenticate with foundryauth
    }
}

# ─────────────────────────────────────────────────────────────────────
# DnD landing - gated (any guild member or admin)
# Replaces the authcrunch portal home page.
# ─────────────────────────────────────────────────────────────────────
dnd.bluefox.cafe {
    import access_log
    import gated_static_site dnd dnd_policy
}

