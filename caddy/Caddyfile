# ─────────────────────────────────────────────────────────────────────
# Monitoring (also Discord-gated)
# ─────────────────────────────────────────────────────────────────────
kuma.bluefox.cafe {
    import gated
    reverse_proxy uptime-kuma:3001
}

logs.bluefox.cafe {
    import gated
    reverse_proxy dozzle:8080
}

# ─────────────────────────────────────────────────────────────────────
# Apex - redirect to auth portal landing
# ─────────────────────────────────────────────────────────────────────
bluefox.cafe {
    import security_headers
    redir https://auth.bluefox.cafe/auth/portal 302
}