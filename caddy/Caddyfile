# Add a new game by copying a block above and pointing it at the matching
# `gated_<guild>` snippet. New guild → also add: env var, user_group_filters
# arg, transform pair, and authorization policy.

# ─────────────────────────────────────────────────────────────────────
# Monitoring - admin-only
# ─────────────────────────────────────────────────────────────────────
kuma.bluefox.cafe {
    import access_log
    import gated_admin
    import error_pages
    import compression
    reverse_proxy uptime-kuma:3001 {
        import proxy_defaults
    }
}

# Uptime Kuma status pages - one host, many pages, each gated separately.
#
# Add a page: create it in Kuma, then add one `import gated_status_slug
# <slug> <policy>` line below. Nothing else changes.
#
# Only slug-scoped routes and the shared SPA bundle are proxied; Kuma's
# dashboard, login and general /api/* are unreachable here. Admin access
# stays on kuma.bluefox.cafe.
#
# socket.io is deliberately absent: viewing a status page is pure REST via
# axios, and the socket is only used by Kuma's own edit mode. Edit status
# pages from kuma.bluefox.cafe.
status.bluefox.cafe {
    import access_log
    import security_headers
    import error_pages
    import compression

    import gated_status_slug foundry dnd_policy

    # Shared by every page: Kuma's index.html references its bundle and any
    # uploaded logo by absolute path, so these can't be slug-scoped. Gated
    # at member level, the loosest policy any slug uses - the bundle is the
    # stock Kuma frontend and discloses nothing. Admins match dnd_policy
    # too, so an admin-only page still loads its assets.
    @status_shared path /assets/* /upload/*
    handle @status_shared {
        authorize with dnd_policy
        reverse_proxy uptime-kuma:3001 {
            import proxy_defaults
        }
    }

    # Bare / has no meaningful target once there are several pages.
    handle {
        error 404
    }
}

logs.bluefox.cafe {
    import access_log
    import gated_admin
    import error_pages
    import compression
    reverse_proxy dozzle:8080 {
        import proxy_defaults
    }
}

# ─────────────────────────────────────────────────────────────────────
# Filebrowser - Discord-gated at the edge (any guild member), then
# filebrowser's own user list is the authoritative ACL. Per-user scope
# (which game's modules they can see) is set inside filebrowser.
# ─────────────────────────────────────────────────────────────────────
files.bluefox.cafe {
    import access_log
    import gated_proxy_site files dnd_policy filebrowser:80
}

# ─────────────────────────────────────────────────────────────────────
# Catchall - any *.bluefox.cafe subdomain not matched above.
# Without this, unknown subdomains hit Caddy's default fallback with no
# valid cert for that hostname, so browsers show a cert mismatch warning
# before the user ever sees a response. The wildcard cert (issued via
# Cloudflare DNS-01) covers anything under bluefox.cafe so we can return
# a clean themed 404 instead.
# ─────────────────────────────────────────────────────────────────────
*.bluefox.cafe {
    import access_log
    import security_headers
    import error_pages
    import compression
    error 404
}
