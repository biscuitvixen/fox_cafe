{
    # Global options block

    email {$ACME_EMAIL}

    # Disable the admin API on its default port. We don't manage Caddy via API,
    # and leaving this open inside the container is mild attack surface.
    admin off

    # ─────────────────────────────────────────────────────────────────
    # caddy-security: identity provider, auth portal, authorization policies
    # ─────────────────────────────────────────────────────────────────
    security {
        # Discord as the OAuth identity provider.
        # `user_group_filters` accepts multiple guild IDs (space-separated).
        # For each guild the user is in, authcrunch attaches a synthetic role
        # `discord.com/<guild_id>/members` to their session token. We then
        # map those guild roles to local roles in the transforms below.
        oauth identity provider discord {
            realm discord
            driver discord
            client_id     {$DISCORD_CLIENT_ID}
            client_secret {$DISCORD_CLIENT_SECRET}
            scopes identify guilds
            # Add additional guild IDs here as new Discord servers come online.
            user_group_filters {$DISCORD_GUILD_DEMIPLANE}
            # user_group_filters {$DISCORD_GUILD_DEMIPLANE} {$DISCORD_GUILD_EXAMPLE_2}
        }

        # The auth portal - owns the OAuth flow + JWT issuance. Its built-in
        # home page UI is intentionally not linked from anywhere; we serve our
        # own landing page instead (see dnd.bluefox.cafe below).
        authentication portal foundryauth {
            crypto default token lifetime 604800
            crypto key sign-verify {$JWT_SHARED_KEY}

            enable identity provider discord

            # CRITICAL: cookie domain must be the apex, NOT a subdomain.
            # This is what makes one login cover all *.bluefox.cafe sites.
            cookie domain bluefox.cafe
            cookie lifetime 604800
            # CSRF defence: browser refuses to attach this cookie to
            # cross-site POSTs / fetches / iframes. `lax` (not `strict`)
            # because the OAuth callback redirect from discord.com needs
            # the cookie on a top-level navigation - `strict` would break
            # the login flow.
            cookie samesite lax

            # Honour the redirect_url query param (which the policy auto-appends
            # when bouncing unauthenticated users here). Without this directive
            # authcrunch treats every off-portal redirect as untrusted and
            # silently drops the user on the portal home after OAuth instead of
            # sending them back where they came from.
            trust login redirect uri domain suffix bluefox.cafe path prefix /

            # Demiplane guild → guild-specific role + generic member role.
            # One Discord server currently gates every game; if a game ever
            # needs its own guild, copy the example block below.
            transform user {
                match role discord.com/{$DISCORD_GUILD_DEMIPLANE}/members
                action add role authp/guild_demiplane
            }
            transform user {
                match role discord.com/{$DISCORD_GUILD_DEMIPLANE}/members
                action add role authp/member
            }

            # Template for a future second guild. Uncomment, swap the env var
            # and role names, and add a matching authorization policy below.
            # transform user {
            #     match role discord.com/{$DISCORD_GUILD_EXAMPLE_2}/members
            #     action add role authp/guild_example_2
            # }
            # transform user {
            #     match role discord.com/{$DISCORD_GUILD_EXAMPLE_2}/members
            #     action add role authp/member
            # }

            # Admin (me). authcrunch exposes the Discord user as
            # sub=discord.com/<user_id>.
            transform user {
                match sub discord.com/{$DISCORD_ADMIN_USER_ID}
                action add role authp/admin
            }

            # Compatibility role: authcrunch's own portal ACL wants
            # authp/user on logged-in users. We don't expose the portal home,
            # but keep this so /auth/* never surprises us. NO service
            # authorizes on authp/user - only on guild_*, member, or admin.
            transform user {
                match realm discord
                action add role authp/user
            }
        }

        # ─────────────────────────────────────────────────────────────
        # Authorization policies (one per access tier)
        # ─────────────────────────────────────────────────────────────

        # DnD landing page - any guild member or admin.
        authorization policy dnd_policy {
            set auth url https://auth.bluefox.cafe/auth/
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "any guild member"
                match role authp/member
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Demiplane games - demiplane guild + admin.
        # Currently gates both beastworld and starwars; split into per-game
        # policies if/when those games need separate guilds.
        authorization policy demiplane_policy {
            set auth url https://auth.bluefox.cafe/auth/
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "demiplane guild"
                match role authp/guild_demiplane
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Template policy for a future second guild - admin + that guild.
        # Safe to leave active: the matching transform that produces
        # authp/guild_example_2 is commented out above, so this currently
        # denies everyone except admin. Activate by (1) setting
        # DISCORD_GUILD_EXAMPLE_2 in .env, (2) uncommenting the transform
        # block above, (3) uncommenting the user_group_filters entry, and
        # (4) importing gated_example_2 on the relevant site block.
        authorization policy example_2_policy {
            set auth url https://auth.bluefox.cafe/auth/
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin everywhere"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "example_2 guild"
                match role authp/guild_example_2
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }

        # Admin-only - uptime, logs, anything ops.
        authorization policy admin_policy {
            set auth url https://auth.bluefox.cafe/auth/
            crypto key verify {$JWT_SHARED_KEY}
            crypto default token name AUTHP_SESSION_ID

            acl rule {
                comment "admin only"
                match role authp/admin
                allow stop
            }
            acl rule {
                comment "deny everyone else"
                match any
                deny stop
            }
        }
    }
}

# ─────────────────────────────────────────────────────────────────────
# Reusable snippets - keep per-site config DRY
# ─────────────────────────────────────────────────────────────────────

(security_headers) {
    header {
        # HSTS: tell browsers to ALWAYS use HTTPS for this domain for 1 year.
        # `preload` requests inclusion in the browser-shipped HSTS list.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Block content-type sniffing - defence against MIME confusion attacks.
        X-Content-Type-Options "nosniff"
        # Send origin only (no path) on cross-origin requests.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Don't advertise that we're Caddy.
        -Server
    }
}

(gated_dnd) {
    import security_headers
    authorize with dnd_policy
}

(gated_demiplane) {
    import security_headers
    authorize with demiplane_policy
}

(gated_example_2) {
    import security_headers
    authorize with example_2_policy
}

(gated_admin) {
    import security_headers
    authorize with admin_policy
}

# ─────────────────────────────────────────────────────────────────────
# Apex - public homepage
# ─────────────────────────────────────────────────────────────────────
bluefox.cafe {
    import security_headers

    # Shared theme assets (CSS/JS) used by every *.bluefox.cafe page.
    # Served publicly so gated subdomains can <link>/<script> them without
    # tripping the auth wall on each asset request.
    handle_path /shared/* {
        root * /srv/shared
        file_server
        header Cache-Control "public, max-age=3600"
    }

    handle {
        root * /srv/homepage
        file_server
    }

    encode zstd gzip
}

# ─────────────────────────────────────────────────────────────────────
# Auth portal - public, this is where the Discord redirect lands
# ─────────────────────────────────────────────────────────────────────
auth.bluefox.cafe {
    import security_headers
    route /auth* {
        authenticate with foundryauth
    }
}

# ─────────────────────────────────────────────────────────────────────
# DnD landing - gated (any guild member or admin)
# Replaces the authcrunch portal home page.
# ─────────────────────────────────────────────────────────────────────
dnd.bluefox.cafe {
    import gated_dnd
    root * /srv/dnd
    file_server
    encode zstd gzip
}

# ─────────────────────────────────────────────────────────────────────
# Foundry games - gated per guild
# ─────────────────────────────────────────────────────────────────────

# Sandbox / test instance - admin-only (no guild attached).
# test.bluefox.cafe {
#     import gated_admin
#     reverse_proxy foundry-test:30000
#     encode zstd gzip
# }

beastworld.bluefox.cafe {
    import gated_demiplane
    reverse_proxy foundry-beastworld:30000
    encode zstd gzip
}

starwars.bluefox.cafe {
    import gated_demiplane
    reverse_proxy foundry-starwars:30000
    encode zstd gzip
}

# Add a new game by copying a block above and pointing it at the matching
# `gated_<guild>` snippet. New guild → also add: env var, user_group_filters
# arg, transform pair, and authorization policy.

# ─────────────────────────────────────────────────────────────────────
# Monitoring - admin-only
# ─────────────────────────────────────────────────────────────────────
kuma.bluefox.cafe {
    import gated_admin
    reverse_proxy uptime-kuma:3001
}

logs.bluefox.cafe {
    import gated_admin
    reverse_proxy dozzle:8080
}

# ─────────────────────────────────────────────────────────────────────
# Filebrowser - Discord-gated at the edge (any guild member), then
# filebrowser's own user list is the authoritative ACL. Per-user scope
# (which game's modules they can see) is set inside filebrowser.
# ─────────────────────────────────────────────────────────────────────
files.bluefox.cafe {
    import gated_dnd
    reverse_proxy filebrowser:80
    encode zstd gzip
}
