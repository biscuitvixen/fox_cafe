demiplane.bluefox.cafe {
    import access_log
    import gated_proxy_site demiplane demiplane_policy foundry-demiplane:30000
}

beastworld.bluefox.cafe {
    import access_log
    import gated_proxy_site beastworld demiplane_policy foundry-beastworld:30000
