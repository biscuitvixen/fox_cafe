{
    # Dev-only: no ACME, no TLS, no auth plugin needed.
    admin off
}

:80 {
    # Whole site served from the release-symlink layout published by
    # ~/bluefox.cafe/deploy.sh. Bot preview pages (/previews/<name>/) and
    # the apex homepage all live in this tree, so plain file_server covers
    # them.
    root * /srv/bluefox.cafe/current

    # Error pages emitted by the Hugo build as pretty URLs. We re-declare
    # root here because handle_errors runs in a separate phase that doesn't
    # inherit the site-level root in older Caddy versions; safer to be
    # explicit than to debug a silent 404 later.
    handle_errors 401 403 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/403/
        file_server
    }
    handle_errors 404 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/404/
        file_server
    }
    handle_errors 500 502 503 504 {
        root * /srv/bluefox.cafe/current
        rewrite * /errors/5xx/
        file_server
    }

    # Error page previews - open in dev (no admin gate needed). Path
    # mirrors prod's /admin/error-preview/<code> so dev and prod URLs
    # match; the bot link-preview pages stay under /previews/<name>/.
    handle /admin/error-preview/403 {
        error 403
    }
    handle /admin/error-preview/404 {
        error 404
    }
    handle /admin/error-preview/500 {
        error 500
    }
    handle /admin/error-preview/502 {
        error 502
    }
    handle /admin/error-preview/503 {
        error 503
    }

    # /forbidden mirrors the prod auth redirect target.
    handle /forbidden {
        error 403
    }

    # DnD landing page (gated in prod, open in dev).
    handle /dnd* {
        rewrite * /dnd/
        file_server
    }

    # Everything else (apex index, css/, fonts/, shared/, previews/<name>/)
    # resolves straight off the site root.
    handle {
        file_server
    }

    encode zstd gzip
}
